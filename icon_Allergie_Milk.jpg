UPDATE cart_items
SET allowed_tolerance_g = 50.0
WHERE product_id = 6 AND allowed_tolerance_g IS NULL;

UPDATE cart_items
SET allowed_tolerance_g = 25.0
WHERE product_id = 5 AND allowed_tolerance_g IS NULL;

UPDATE cart_items
SET allowed_tolerance_g = 35.0
WHERE product_id = 13 AND allowed_tolerance_g IS NULL;