-- =========================================================
-- 12. 확인용 SELECT
-- =========================================================

SHOW TABLES;

-- 상품 + 구역 확인
SELECT
  p.product_id,
  p.product_name,
  p.category_name,
  p.price,
  z.zone_code,
  z.zone_name,
  p.standard_weight_g
FROM products p
LEFT JOIN zones z ON p.zone_id = z.zone_id
ORDER BY p.product_id;

-- 1번 사용자 특이사항 확인
SELECT
  u.user_name,
  uc.condition_type,
  i.ingredient_name,
  uc.condition_value,
  uc.severity
FROM user_conditions uc
JOIN users u ON uc.user_id = u.user_id
LEFT JOIN ingredients i ON uc.ingredient_id = i.ingredient_id
WHERE uc.user_id = 1;

-- 1번 사용자가 땅콩버터를 담았을 때 알레르기 경고 여부
SELECT
  u.user_name,
  p.product_name,
  i.ingredient_name AS warning_ingredient,
  'WARNING' AS result
FROM users u
JOIN user_conditions uc ON u.user_id = uc.user_id
JOIN ingredients i ON uc.ingredient_id = i.ingredient_id
JOIN product_ingredients pi ON i.ingredient_id = pi.ingredient_id
JOIN products p ON pi.product_id = p.product_id
WHERE u.user_id = 1
  AND uc.condition_type = 'allergy'
  AND p.product_id = 1;

-- AP 기준 RSSI 확인
SELECT
  z.zone_code,
  z.zone_name,
  ap.ssid,
  ap.bssid,
  zar.avg_rssi,
  zar.sample_count
FROM zone_ap_rssi zar
JOIN zones z ON zar.zone_id = z.zone_id
JOIN access_points ap ON zar.ap_id = ap.ap_id
ORDER BY z.zone_id, ap.ap_id;

-- 현재 실시간 AP 스캔값과 구역별 평균 RSSI 비교
-- distance_score가 가장 낮은 구역이 현재 위치 후보
SELECT
  z.zone_code,
  z.zone_name,
  ROUND(SUM(ABS(acs.current_rssi - zar.avg_rssi)), 2) AS distance_score
FROM ap_current_scans acs
JOIN zone_ap_rssi zar ON acs.ap_id = zar.ap_id
JOIN zones z ON zar.zone_id = z.zone_id
WHERE acs.scan_group_id = 1
GROUP BY z.zone_code, z.zone_name
ORDER BY distance_score ASC;

-- KNN 학습 벡터 확인
SELECT
  u.user_name,
  ktv.age_score,
  ktv.budget_score,
  ktv.spicy_score,
  ktv.beverage_count,
  ktv.snack_count,
  ktv.ramen_count,
  ktv.instant_count,
  ktv.allergy_milk,
  ktv.allergy_peanut,
  ktv.allergy_wheat,
  ktv.allergy_shrimp,
  ktv.total_purchase_count,
  ktv.trained_at
FROM knn_training_vectors ktv
JOIN users u ON ktv.user_id = u.user_id
ORDER BY ktv.user_id;

-- KNN용 DataFrame 기본 조회 쿼리
SELECT
  u.user_id,
  u.user_name,
  up.age_group,
  up.gender,
  up.budget_level,
  up.preferred_category,
  up.spicy_preference,
  up.health_preference,
  p.category_name,
  COUNT(ph.product_id) AS purchase_count
FROM users u
LEFT JOIN user_profiles up ON u.user_id = up.user_id
LEFT JOIN purchase_history ph ON u.user_id = ph.user_id
LEFT JOIN products p ON ph.product_id = p.product_id
GROUP BY
  u.user_id,
  u.user_name,
  up.age_group,
  up.gender,
  up.budget_level,
  up.preferred_category,
  up.spicy_preference,
  up.health_preference,
  p.category_name
ORDER BY u.user_id, p.category_name;

-- 추천 결과 확인
SELECT
  r.recommendation_id,
  u.user_name,
  z.zone_name,
  p.product_name,
  r.score,
  r.reason,
  r.created_at
FROM recommendations r
JOIN users u ON r.user_id = u.user_id
LEFT JOIN zones z ON r.zone_id = z.zone_id
JOIN products p ON r.product_id = p.product_id
WHERE r.user_id = 1
ORDER BY r.score DESC;

