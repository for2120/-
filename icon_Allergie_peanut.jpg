-- =========================================================
-- 1. 테이블 설명 COMMENT
-- =========================================================

ALTER TABLE users COMMENT = '회원 기본 정보 테이블';
ALTER TABLE ingredients COMMENT = '알레르기 및 상품 성분 정보 테이블';
ALTER TABLE zones COMMENT = '매장 또는 학교 내부 구역 정보 테이블';
ALTER TABLE products COMMENT = '상품 기본 정보 및 상품이 위치한 구역 정보 테이블';
ALTER TABLE rfid_tags COMMENT = 'RFID 태그 UID와 상품을 연결하는 테이블';
ALTER TABLE product_ingredients COMMENT = '상품과 성분의 다대다 관계를 저장하는 테이블';
ALTER TABLE user_profiles COMMENT = 'KNN 추천에 사용하는 회원 프로필 정보 테이블';
ALTER TABLE user_conditions COMMENT = '회원의 알레르기, 종교 제한, 식단 제한 등 특이사항 테이블';
ALTER TABLE cart_items COMMENT = '현재 장바구니 상품 및 로드셀 검증 결과 테이블';
ALTER TABLE purchase_history COMMENT = 'KNN 학습에 사용하는 과거 구매이력 테이블';
ALTER TABLE access_points COMMENT = '학교 내부 Wi-Fi AP 정보 테이블';
ALTER TABLE zone_ap_rssi COMMENT = '구역별 AP 평균 RSSI 기준값 테이블';
ALTER TABLE ap_current_scans COMMENT = '라즈베리파이가 실시간으로 스캔한 AP RSSI 값 테이블';
ALTER TABLE knn_training_vectors COMMENT = 'Python에서 전처리한 KNN 학습용 회원 벡터 테이블';
ALTER TABLE recommendations COMMENT = 'KNN 추천 결과 저장 테이블';

-- =========================================================
-- 2. users 컬럼 설명
-- =========================================================

ALTER TABLE users
  MODIFY COLUMN user_id INT NOT NULL AUTO_INCREMENT COMMENT '회원 기본키(PK)',
  MODIFY COLUMN user_name VARCHAR(50) NOT NULL COMMENT '회원 이름';

-- =========================================================
-- 3. ingredients 컬럼 설명
-- =========================================================

ALTER TABLE ingredients
  MODIFY COLUMN ingredient_id INT NOT NULL AUTO_INCREMENT COMMENT '성분 기본키(PK)',
  MODIFY COLUMN ingredient_name VARCHAR(100) NOT NULL COMMENT '성분명 또는 알레르기 유발 성분명';

-- =========================================================
-- 4. zones 컬럼 설명
-- =========================================================

ALTER TABLE zones
  MODIFY COLUMN zone_id INT NOT NULL AUTO_INCREMENT COMMENT '구역 기본키(PK)',
  MODIFY COLUMN zone_code VARCHAR(10) NOT NULL COMMENT '구역 코드 예: A, B, C, D',
  MODIFY COLUMN zone_name VARCHAR(50) NOT NULL COMMENT '구역 이름 예: 음료 코너, 과자 코너',
  MODIFY COLUMN ui_page VARCHAR(100) DEFAULT NULL COMMENT '해당 구역에서 표시할 UI 화면 이름',
  MODIFY COLUMN description VARCHAR(255) DEFAULT NULL COMMENT '구역 설명';

-- =========================================================
-- 5. products 컬럼 설명
-- =========================================================

ALTER TABLE products
  MODIFY COLUMN product_id INT NOT NULL AUTO_INCREMENT COMMENT '상품 기본키(PK)',
  MODIFY COLUMN product_name VARCHAR(100) NOT NULL COMMENT '상품명',
  MODIFY COLUMN price INT NOT NULL COMMENT '상품 가격',
  MODIFY COLUMN image_url VARCHAR(255) DEFAULT NULL COMMENT 'UI에 표시할 상품 이미지 경로',
  MODIFY COLUMN category_name VARCHAR(50) DEFAULT NULL COMMENT '상품 카테고리명',
  MODIFY COLUMN zone_id INT DEFAULT NULL COMMENT '상품이 진열된 구역 ID. zones.zone_id 참조 (N:1, 여러 상품이 하나의 구역에 속함)',
  MODIFY COLUMN standard_weight_g FLOAT DEFAULT NULL COMMENT '로드셀 검증용 상품 기준 무게(g)',
  MODIFY COLUMN product_desc VARCHAR(255) DEFAULT NULL COMMENT '상품 설명';

-- =========================================================
-- 6. rfid_tags 컬럼 설명
-- =========================================================

ALTER TABLE rfid_tags
  MODIFY COLUMN tag_uid VARCHAR(64) NOT NULL COMMENT 'RFID 태그 UID. RFID 카드 또는 태그의 고유값(PK)',
  MODIFY COLUMN product_id INT NOT NULL COMMENT '해당 RFID 태그가 가리키는 상품 ID. products.product_id 참조 (N:1, 여러 RFID 태그가 하나의 상품에 연결될 수 있음)';

-- =========================================================
-- 7. product_ingredients 컬럼 설명
-- =========================================================

ALTER TABLE product_ingredients
  MODIFY COLUMN product_id INT NOT NULL COMMENT '성분이 포함된 상품 ID. products.product_id 참조 (N:1)',
  MODIFY COLUMN ingredient_id INT NOT NULL COMMENT '상품에 포함된 성분 ID. ingredients.ingredient_id 참조 (N:1)';

-- =========================================================
-- 8. user_profiles 컬럼 설명
-- =========================================================

ALTER TABLE user_profiles
  MODIFY COLUMN user_id INT NOT NULL COMMENT '회원 ID. users.user_id 참조 (1:1, 회원 1명당 프로필 1개)',
  MODIFY COLUMN age_group VARCHAR(20) DEFAULT NULL COMMENT '회원 나이대. KNN 추천 입력값',
  MODIFY COLUMN gender VARCHAR(20) DEFAULT NULL COMMENT '회원 성별. KNN 추천 입력값',
  MODIFY COLUMN budget_level VARCHAR(20) DEFAULT NULL COMMENT '예산 수준. 낮음/중간/높음 등 KNN 추천 입력값',
  MODIFY COLUMN preferred_category VARCHAR(50) DEFAULT NULL COMMENT '선호 카테고리. KNN 추천 입력값',
  MODIFY COLUMN spicy_preference INT DEFAULT NULL COMMENT '매운맛 선호도. KNN 추천 입력값',
  MODIFY COLUMN health_preference VARCHAR(100) DEFAULT NULL COMMENT '건강 관련 선호도. 예: 저당, 저칼로리, 고단백',
  MODIFY COLUMN special_note VARCHAR(255) DEFAULT NULL COMMENT '회원 특이사항 요약 메모';

-- =========================================================
-- 9. user_conditions 컬럼 설명
-- =========================================================

ALTER TABLE user_conditions
  MODIFY COLUMN condition_id INT NOT NULL AUTO_INCREMENT COMMENT '회원 특이사항 기본키(PK)',
  MODIFY COLUMN user_id INT NOT NULL COMMENT '특이사항을 가진 회원 ID. users.user_id 참조 (N:1, 한 회원이 여러 특이사항을 가질 수 있음)',
  MODIFY COLUMN condition_type VARCHAR(50) NOT NULL COMMENT '특이사항 유형. 예: allergy, religion, diet, restriction',
  MODIFY COLUMN ingredient_id INT DEFAULT NULL COMMENT '관련 성분 ID. ingredients.ingredient_id 참조 (N:1, 알레르기/제한 성분이 있을 때만 사용)',
  MODIFY COLUMN condition_value VARCHAR(100) DEFAULT NULL COMMENT '특이사항 내용. 예: 우유 알레르기, 돼지고기 제한',
  MODIFY COLUMN severity VARCHAR(20) DEFAULT NULL COMMENT '위험도 또는 중요도. 예: 낮음, 중간, 높음';

-- =========================================================
-- 10. cart_items 컬럼 설명
-- =========================================================

ALTER TABLE cart_items
  MODIFY COLUMN cart_item_id INT NOT NULL AUTO_INCREMENT COMMENT '장바구니 항목 기본키(PK)',
  MODIFY COLUMN user_id INT NOT NULL COMMENT '장바구니를 사용하는 회원 ID. users.user_id 참조 (N:1)',
  MODIFY COLUMN product_id INT NOT NULL COMMENT '장바구니에 담긴 상품 ID. products.product_id 참조 (N:1)',
  MODIFY COLUMN quantity INT NOT NULL DEFAULT 1 COMMENT '장바구니에 담긴 상품 수량',
  MODIFY COLUMN expected_weight_g FLOAT DEFAULT NULL COMMENT '상품 기준 무게와 수량을 바탕으로 계산한 예상 무게(g)',
  MODIFY COLUMN measured_weight_g FLOAT DEFAULT NULL COMMENT '로드셀로 측정한 실제 무게(g)',
  MODIFY COLUMN weight_matched TINYINT(1) DEFAULT NULL COMMENT '로드셀 검증 결과. 1=정상, 0=불일치',
  MODIFY COLUMN added_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '장바구니에 상품이 추가된 시간';

-- =========================================================
-- 11. purchase_history 컬럼 설명
-- =========================================================

ALTER TABLE purchase_history
  MODIFY COLUMN history_id INT NOT NULL AUTO_INCREMENT COMMENT '구매이력 기본키(PK)',
  MODIFY COLUMN user_id INT NOT NULL COMMENT '구매한 회원 ID. users.user_id 참조 (N:1)',
  MODIFY COLUMN product_id INT NOT NULL COMMENT '구매한 상품 ID. products.product_id 참조 (N:1)',
  MODIFY COLUMN quantity INT NOT NULL DEFAULT 1 COMMENT '구매 수량',
  MODIFY COLUMN purchased_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '구매 일시. KNN 학습용 구매이력 시간';

-- =========================================================
-- 12. access_points 컬럼 설명
-- =========================================================

ALTER TABLE access_points
  MODIFY COLUMN ap_id INT NOT NULL AUTO_INCREMENT COMMENT 'AP 기본키(PK)',
  MODIFY COLUMN ssid VARCHAR(100) DEFAULT NULL COMMENT 'Wi-Fi 이름. 예: School_WiFi',
  MODIFY COLUMN bssid VARCHAR(50) NOT NULL COMMENT 'AP 고유 MAC 주소. 같은 SSID를 구분하기 위한 값',
  MODIFY COLUMN location_hint VARCHAR(100) DEFAULT NULL COMMENT 'AP가 위치한 장소 설명';

-- =========================================================
-- 13. zone_ap_rssi 컬럼 설명
-- =========================================================

ALTER TABLE zone_ap_rssi
  MODIFY COLUMN rssi_id INT NOT NULL AUTO_INCREMENT COMMENT '구역별 AP RSSI 기준값 기본키(PK)',
  MODIFY COLUMN zone_id INT NOT NULL COMMENT '측정 기준 구역 ID. zones.zone_id 참조 (N:1, 한 구역에 여러 AP 기준값이 존재)',
  MODIFY COLUMN ap_id INT NOT NULL COMMENT '측정 대상 AP ID. access_points.ap_id 참조 (N:1)',
  MODIFY COLUMN avg_rssi FLOAT NOT NULL COMMENT '해당 구역에서 측정한 AP 평균 RSSI 값',
  MODIFY COLUMN sample_count INT DEFAULT 0 COMMENT '평균 RSSI 계산에 사용한 측정 횟수';

-- =========================================================
-- 14. ap_current_scans 컬럼 설명
-- =========================================================

ALTER TABLE ap_current_scans
  MODIFY COLUMN scan_id INT NOT NULL AUTO_INCREMENT COMMENT '실시간 AP 스캔값 기본키(PK)',
  MODIFY COLUMN scan_group_id INT NOT NULL COMMENT '한 번의 실시간 스캔 묶음 ID. 같은 시간에 잡힌 AP들을 하나의 그룹으로 묶음',
  MODIFY COLUMN user_id INT DEFAULT NULL COMMENT '현재 카트를 사용하는 회원 ID. users.user_id 참조 (N:1, 테스트 시 NULL 가능)',
  MODIFY COLUMN ap_id INT NOT NULL COMMENT '실시간으로 감지된 AP ID. access_points.ap_id 참조 (N:1)',
  MODIFY COLUMN current_rssi FLOAT NOT NULL COMMENT '라즈베리파이가 현재 위치에서 측정한 AP RSSI 값',
  MODIFY COLUMN scanned_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT 'AP 스캔 시간';

-- =========================================================
-- 15. knn_training_vectors 컬럼 설명
-- =========================================================

ALTER TABLE knn_training_vectors
  MODIFY COLUMN vector_id INT NOT NULL AUTO_INCREMENT COMMENT 'KNN 학습 벡터 기본키(PK)',
  MODIFY COLUMN user_id INT NOT NULL COMMENT '벡터화된 회원 ID. users.user_id 참조 (N:1)',
  MODIFY COLUMN age_score FLOAT DEFAULT 0 COMMENT '나이대를 숫자로 변환한 KNN 입력값',
  MODIFY COLUMN budget_score FLOAT DEFAULT 0 COMMENT '예산 수준을 숫자로 변환한 KNN 입력값',
  MODIFY COLUMN spicy_score FLOAT DEFAULT 0 COMMENT '매운맛 선호도를 숫자로 변환한 KNN 입력값',
  MODIFY COLUMN beverage_count FLOAT DEFAULT 0 COMMENT '음료 카테고리 구매 횟수',
  MODIFY COLUMN snack_count FLOAT DEFAULT 0 COMMENT '과자 카테고리 구매 횟수',
  MODIFY COLUMN ramen_count FLOAT DEFAULT 0 COMMENT '라면 카테고리 구매 횟수',
  MODIFY COLUMN living_count FLOAT DEFAULT 0 COMMENT '생활용품 카테고리 구매 횟수',
  MODIFY COLUMN instant_count FLOAT DEFAULT 0 COMMENT '간편식 카테고리 구매 횟수',
  MODIFY COLUMN allergy_milk TINYINT(1) DEFAULT 0 COMMENT '우유 알레르기 여부. 1=있음, 0=없음',
  MODIFY COLUMN allergy_peanut TINYINT(1) DEFAULT 0 COMMENT '땅콩 알레르기 여부. 1=있음, 0=없음',
  MODIFY COLUMN allergy_wheat TINYINT(1) DEFAULT 0 COMMENT '밀 알레르기 여부. 1=있음, 0=없음',
  MODIFY COLUMN allergy_shrimp TINYINT(1) DEFAULT 0 COMMENT '새우 알레르기 여부. 1=있음, 0=없음',
  MODIFY COLUMN total_purchase_count INT DEFAULT 0 COMMENT '전체 구매 횟수',
  MODIFY COLUMN trained_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT 'Python pandas로 벡터화 또는 학습 데이터를 생성한 시간';

-- =========================================================
-- 16. recommendations 컬럼 설명
-- =========================================================

ALTER TABLE recommendations
  MODIFY COLUMN recommendation_id INT NOT NULL AUTO_INCREMENT COMMENT '추천 결과 기본키(PK)',
  MODIFY COLUMN user_id INT NOT NULL COMMENT '추천 대상 회원 ID. users.user_id 참조 (N:1)',
  MODIFY COLUMN zone_id INT DEFAULT NULL COMMENT '추천이 발생한 현재 구역 ID. zones.zone_id 참조 (N:1, 위치 기반 추천에 사용)',
  MODIFY COLUMN product_id INT NOT NULL COMMENT '추천된 상품 ID. products.product_id 참조 (N:1)',
  MODIFY COLUMN score FLOAT DEFAULT NULL COMMENT 'KNN 추천 점수 또는 유사도 점수',
  MODIFY COLUMN reason VARCHAR(255) DEFAULT NULL COMMENT '추천 사유. 예: 현재 구역, 유사 고객 구매이력, 선호 카테고리 기반',
  MODIFY COLUMN created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '추천 결과 생성 시간';


SHOW DATABASES;
USE smartcart;
SHOW TABLES;

USE smartcart;
SHOW FULL COLUMNS FROM products;
