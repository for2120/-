-- =========================================================
-- SmartCart 간소화 최종 DB
-- 총 15개 테이블
-- RFID + 알레르기/특이사항 + AP/RSSI 구역판별 + KNN 학습 더미 + 추천결과
-- =========================================================

SET NAMES utf8mb4 COLLATE utf8mb4_general_ci;

DROP DATABASE IF EXISTS smartcart;

CREATE DATABASE smartcart
  DEFAULT CHARACTER SET utf8mb4
  DEFAULT COLLATE utf8mb4_general_ci;

USE smartcart;
SHOW TABLES;

SET FOREIGN_KEY_CHECKS = 0;

-- =========================================================
-- 1. 기본 테이블
-- =========================================================

CREATE TABLE users (
  user_id INT NOT NULL AUTO_INCREMENT,
  user_name VARCHAR(50) NOT NULL,
  PRIMARY KEY (user_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE ingredients (
  ingredient_id INT NOT NULL AUTO_INCREMENT,
  ingredient_name VARCHAR(100) NOT NULL,
  PRIMARY KEY (ingredient_id),
  UNIQUE KEY uk_ingredient_name (ingredient_name)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE zones (
  zone_id INT NOT NULL AUTO_INCREMENT,
  zone_code VARCHAR(10) NOT NULL,
  zone_name VARCHAR(50) NOT NULL,
  ui_page VARCHAR(100) DEFAULT NULL,
  description VARCHAR(255) DEFAULT NULL,
  PRIMARY KEY (zone_id),
  UNIQUE KEY uk_zone_code (zone_code)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- =========================================================
-- 2. 상품 / RFID / 성분
-- =========================================================

CREATE TABLE products (
  product_id INT NOT NULL AUTO_INCREMENT,
  product_name VARCHAR(100) NOT NULL,
  price INT NOT NULL,
  image_url VARCHAR(255) DEFAULT NULL,
  category_name VARCHAR(50) DEFAULT NULL,
  zone_id INT DEFAULT NULL,
  standard_weight_g FLOAT DEFAULT NULL,
  weight_tolerance_g FLOAT DEFAULT NULL,
  weight_tolerance_percent FLOAT DEFAULT NULL,
  product_desc VARCHAR(255) DEFAULT NULL,
  PRIMARY KEY (product_id),
  KEY fk_products_zone (zone_id),
  CONSTRAINT fk_products_zone
    FOREIGN KEY (zone_id) REFERENCES zones(zone_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE rfid_tags (
  tag_uid VARCHAR(64) NOT NULL,
  product_id INT NOT NULL,
  PRIMARY KEY (tag_uid),
  KEY fk_rfid_tags_product (product_id),
  CONSTRAINT fk_rfid_tags_product
    FOREIGN KEY (product_id) REFERENCES products(product_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE product_ingredients (
  product_id INT NOT NULL,
  ingredient_id INT NOT NULL,
  PRIMARY KEY (product_id, ingredient_id),
  KEY fk_product_ingredients_ingredient (ingredient_id),
  CONSTRAINT fk_product_ingredients_product
    FOREIGN KEY (product_id) REFERENCES products(product_id) ON DELETE CASCADE,
  CONSTRAINT fk_product_ingredients_ingredient
    FOREIGN KEY (ingredient_id) REFERENCES ingredients(ingredient_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- =========================================================
-- 3. 회원 프로필 / 특이사항
-- user_conditions = 기존 user_allergies 확장 버전
-- condition_type: allergy, religion, diet, preference 등
-- =========================================================

CREATE TABLE user_profiles (
  user_id INT NOT NULL,
  age_group VARCHAR(20) DEFAULT NULL,
  gender VARCHAR(20) DEFAULT NULL,
  budget_level VARCHAR(20) DEFAULT NULL,
  preferred_category VARCHAR(50) DEFAULT NULL,
  spicy_preference INT DEFAULT NULL,
  health_preference VARCHAR(100) DEFAULT NULL,
  special_note VARCHAR(255) DEFAULT NULL,
  PRIMARY KEY (user_id),
  CONSTRAINT fk_user_profiles_user
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE user_conditions (
  condition_id INT NOT NULL AUTO_INCREMENT,
  user_id INT NOT NULL,
  condition_type VARCHAR(50) NOT NULL,
  ingredient_id INT DEFAULT NULL,
  condition_value VARCHAR(100) DEFAULT NULL,
  severity VARCHAR(20) DEFAULT NULL,
  PRIMARY KEY (condition_id),
  KEY fk_user_conditions_user (user_id),
  KEY fk_user_conditions_ingredient (ingredient_id),
  CONSTRAINT fk_user_conditions_user
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
  CONSTRAINT fk_user_conditions_ingredient
    FOREIGN KEY (ingredient_id) REFERENCES ingredients(ingredient_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- =========================================================
-- 4. 장바구니
-- 로드셀 검증은 별도 로그 테이블 없이 cart_items에 포함
-- =========================================================

CREATE TABLE cart_items (
  cart_item_id INT NOT NULL AUTO_INCREMENT,
  user_id INT NOT NULL,
  product_id INT NOT NULL,
  quantity INT NOT NULL DEFAULT 1,
  expected_weight_g FLOAT DEFAULT NULL,
  measured_weight_g FLOAT DEFAULT NULL,
  allowed_tolerance_g FLOAT DEFAULT NULL,
  weight_matched TINYINT(1) DEFAULT NULL,
  added_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (cart_item_id),
  KEY fk_cart_items_user (user_id),
  KEY fk_cart_items_product (product_id),
  CONSTRAINT fk_cart_items_user
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
  CONSTRAINT fk_cart_items_product
    FOREIGN KEY (product_id) REFERENCES products(product_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE cart_event_log (
  event_id INT NOT NULL AUTO_INCREMENT,
  user_id INT NOT NULL,
  event_type VARCHAR(30) NOT NULL,
  tag_uid VARCHAR(64) DEFAULT NULL,
  product_id INT DEFAULT NULL,
  product_name VARCHAR(100) DEFAULT NULL,
  message VARCHAR(255) NOT NULL,
  item_weight_g FLOAT DEFAULT NULL,
  total_weight_g FLOAT DEFAULT NULL,
  allowed_tolerance_g FLOAT DEFAULT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (event_id),
  KEY idx_cart_event_log_user_created (user_id, created_at),
  KEY idx_cart_event_log_product (product_id),
  CONSTRAINT fk_cart_event_log_user
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
  CONSTRAINT fk_cart_event_log_product
    FOREIGN KEY (product_id) REFERENCES products(product_id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE app_runtime_state (
  state_id TINYINT NOT NULL,
  active_user_id INT DEFAULT NULL,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (state_id),
  KEY fk_app_runtime_state_user (active_user_id),
  CONSTRAINT fk_app_runtime_state_user
    FOREIGN KEY (active_user_id) REFERENCES users(user_id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE app_login_accounts (
  account_id INT NOT NULL AUTO_INCREMENT,
  user_id INT NOT NULL,
  login_id VARCHAR(50) NOT NULL,
  login_password VARCHAR(100) NOT NULL,
  display_name VARCHAR(100) DEFAULT NULL,
  is_active TINYINT(1) NOT NULL DEFAULT 1,
  PRIMARY KEY (account_id),
  UNIQUE KEY uk_app_login_accounts_login_id (login_id),
  KEY fk_app_login_accounts_user (user_id),
  CONSTRAINT fk_app_login_accounts_user
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- =========================================================
-- 5. KNN 학습용 구매이력
-- =========================================================

CREATE TABLE purchase_history (
  history_id INT NOT NULL AUTO_INCREMENT,
  user_id INT NOT NULL,
  product_id INT NOT NULL,
  quantity INT NOT NULL DEFAULT 1,
  purchased_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (history_id),
  KEY fk_purchase_history_user (user_id),
  KEY fk_purchase_history_product (product_id),
  CONSTRAINT fk_purchase_history_user
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
  CONSTRAINT fk_purchase_history_product
    FOREIGN KEY (product_id) REFERENCES products(product_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- =========================================================
-- 6. AP / RSSI 구역 판별
-- zone_ap_rssi = 학교 내부 AP 조사 후 만든 구역별 평균 RSSI 기준값
-- ap_current_scans = 라즈베리파이가 실시간으로 스캔한 값 더미
-- =========================================================

CREATE TABLE access_points (
  ap_id INT NOT NULL AUTO_INCREMENT,
  ssid VARCHAR(100) DEFAULT NULL,
  bssid VARCHAR(50) NOT NULL,
  location_hint VARCHAR(100) DEFAULT NULL,
  PRIMARY KEY (ap_id),
  UNIQUE KEY uk_access_points_bssid (bssid)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE zone_ap_rssi (
  rssi_id INT NOT NULL AUTO_INCREMENT,
  zone_id INT NOT NULL,
  ap_id INT NOT NULL,
  avg_rssi FLOAT NOT NULL,
  sample_count INT DEFAULT 0,
  PRIMARY KEY (rssi_id),
  UNIQUE KEY uk_zone_ap (zone_id, ap_id),
  KEY fk_zone_ap_rssi_zone (zone_id),
  KEY fk_zone_ap_rssi_ap (ap_id),
  CONSTRAINT fk_zone_ap_rssi_zone
    FOREIGN KEY (zone_id) REFERENCES zones(zone_id) ON DELETE CASCADE,
  CONSTRAINT fk_zone_ap_rssi_ap
    FOREIGN KEY (ap_id) REFERENCES access_points(ap_id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE ap_current_scans (
  scan_id INT NOT NULL AUTO_INCREMENT,
  scan_group_id INT NOT NULL,
  user_id INT DEFAULT NULL,
  ap_id INT NOT NULL,
  current_rssi FLOAT NOT NULL,
  scanned_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (scan_id),
  KEY fk_ap_current_scans_user (user_id),
  KEY fk_ap_current_scans_ap (ap_id),
  CONSTRAINT fk_ap_current_scans_user
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE SET NULL,
  CONSTRAINT fk_ap_current_scans_ap
    FOREIGN KEY (ap_id) REFERENCES access_points(ap_id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- =========================================================
-- 7. KNN 학습 완료 데이터 / 추천 결과
-- knn_training_vectors = Python pandas로 전처리/학습한 결과를 저장했다고 가정
-- recommendations = KNN 추천 결과 저장
-- =========================================================

CREATE TABLE knn_training_vectors (
  vector_id INT NOT NULL AUTO_INCREMENT,
  user_id INT NOT NULL,
  age_score FLOAT DEFAULT 0,
  budget_score FLOAT DEFAULT 0,
  spicy_score FLOAT DEFAULT 0,
  beverage_count FLOAT DEFAULT 0,
  snack_count FLOAT DEFAULT 0,
  ramen_count FLOAT DEFAULT 0,
  living_count FLOAT DEFAULT 0,
  instant_count FLOAT DEFAULT 0,
  allergy_milk TINYINT(1) DEFAULT 0,
  allergy_peanut TINYINT(1) DEFAULT 0,
  allergy_wheat TINYINT(1) DEFAULT 0,
  allergy_shrimp TINYINT(1) DEFAULT 0,
  total_purchase_count INT DEFAULT 0,
  trained_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (vector_id),
  KEY fk_knn_training_vectors_user (user_id),
  CONSTRAINT fk_knn_training_vectors_user
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE recommendations (
  recommendation_id INT NOT NULL AUTO_INCREMENT,
  user_id INT NOT NULL,
  zone_id INT DEFAULT NULL,
  product_id INT NOT NULL,
  score FLOAT DEFAULT NULL,
  reason VARCHAR(255) DEFAULT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (recommendation_id),
  KEY fk_recommendations_user (user_id),
  KEY fk_recommendations_zone (zone_id),
  KEY fk_recommendations_product (product_id),
  CONSTRAINT fk_recommendations_user
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
  CONSTRAINT fk_recommendations_zone
    FOREIGN KEY (zone_id) REFERENCES zones(zone_id),
  CONSTRAINT fk_recommendations_product
    FOREIGN KEY (product_id) REFERENCES products(product_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

SET FOREIGN_KEY_CHECKS = 1;

