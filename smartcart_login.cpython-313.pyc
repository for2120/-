  <property name="styleSheet">
   <string notr="true">/* 1. 전체 배경을 흰색으로 채우기 */
QMainWindow {
    background-color: white;
}
QWidget {
    background-color: white;
    color: #000000; /* 글씨는 검은색 */
}

/* 2. 테이블 위젯 디자인 */
QTableWidget {
    border: 1px solid #cccccc; /* 테이블 테두리는 연한 회색 */
    gridline-color: #eeeeee;   /* 격자무늬 색상 */
    selection-background-color: #e0f7fa; /* 선택 시 색상 */
}
QHeaderView::section {
    background-color: white;
    border: none;
    border-bottom: 2px solid #2ecc71; /* 헤더 아래 녹색 줄 */
    font-weight: bold;
    font-size: 14px;
    padding: 5px;
}

/* 3. 버튼 디자인 (녹색) */
QPushButton {
    background-color: #2ecc71;
    color: white;
    border-radius: 5px; /* 모서리 약간 둥글게 */
    padding: 10px;
    font-weight: bold;
    font-size: 14px;
    border: 1px solid #27ae60; /* 버튼 테두리 */
}
QPushButton:pressed {
    background-color: #27ae60; /* 눌렀을 때 진하게 */
}

/* 4. 라벨(글자) 디자인 */
QLabel {
    font-size: 15px;
    padding: 5px;
}</string>
