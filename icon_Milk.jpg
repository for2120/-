#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
VENV_DIR="$PROJECT_DIR/.venv"
PYTHON_EXE="$(command -v python3 || true)"
VENV_PYTHON="$VENV_DIR/bin/python"

if [ -z "$PYTHON_EXE" ]; then
  echo "[ERROR] python3 is not installed."
  echo "Install it first: sudo apt update; sudo apt install -y python3 python3-venv python3-pip"
  exit 1
fi

if [ ! -f "$PROJECT_DIR/queries/middle_4-1.sql" ]; then
  echo "[ERROR] middle_4-1.sql not found."
  echo "Expected path: $PROJECT_DIR/queries/middle_4-1.sql"
  exit 1
fi

if command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get install -y python3-pyqt5 python3-serial python3-pymysql
fi

if [ -d "$VENV_DIR" ]; then
  rm -rf "$VENV_DIR"
fi

"$PYTHON_EXE" -m venv --system-site-packages "$VENV_DIR"

"$VENV_PYTHON" -m pip install --upgrade pip
"$VENV_PYTHON" -m pip install pyserial pymysql

chmod +x "$SCRIPT_DIR/run_smartcart.sh" "$SCRIPT_DIR/run_smartcart_pi.sh"

echo "======================================"
echo "SmartCart Raspberry setup complete"
echo "Project: $PROJECT_DIR"
echo "Virtualenv: $VENV_DIR"
echo "PyQt5 source: system package (python3-pyqt5)"
echo "Next: edit scripts/run_smartcart.local.sh if DB credentials, loadcell port, or RFID ports differ"
echo "Run: cd $SCRIPT_DIR && ./run_smartcart.sh"
echo "======================================"
